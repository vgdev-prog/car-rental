{% extends 'base.html.twig' %}

{% block title %}Maintenance - Car Details{% endblock %}
{% set tab = 'details' %}

{% block content %}
    {% include 'partials/_maintenance_tabs.html.twig' with { current_tab: tab } %}
    <div class="pj-availability-form">
        <fieldset class="fieldset white">
            <form name="frmGetMaintenance" id="frmGetMaintenance" class="form pj-form">
                <div class="pj-filter-block">
                    <div class="pj-filter-block w300" style="margin-left: 10px">
                        <span class="inline-block fix-width">
                            <select name="car_id" id="car_id" class="pj-form-field w300">
                                <option value="">-- Choose --</option>
                            </select>
                        </span>
                    </div>
                </div>
                <div class="pj-filter-block">
                    <button type="submit" class="pj-button">Search</button>
                </div>
            </form>
        </fieldset>
    </div>
    <fieldset class="fieldset white">
        <form action="#" method="post" id="frmUpdate" class="form pj-form">
            <table class="pj-table" id="tblMaintenance" cellpadding="0" cellspacing="0" style="width: 100%">
                <thead>
                <tr>
                    <th style="width: 100px;">Category</th>
                    <th>Description</th>
                    <th>KM</th>
                    <th style="width: 100px;">Amount</th>
                    <th style="width: 100px;">Date</th>
                    <th style="width: 30px;">&nbsp;</th>
                </tr>
                </thead>
                <tbody id="maintenanceBody">
                <tr>
                    <td colspan="6">No record found.</td>
                </tr>
                </tbody>
            </table>
            <p>
                <input type="submit" value="Save" class="pj-button" id="btnSaveMaintenance"/>
                <input type="button" value="Add +" class="pj-button" id="btnAddMaintenance"/>
                <label style="float: right; margin: 10px 0 0 10px; font-size: 16px;" id="grandTotal">Grant total: $0.00</label>
            </p>
        </form>
        <div id="paginationContainer"></div>
    </fieldset>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const ROWS_PER_PAGE_OPTIONS = [10, 20, 50, 100, 200, 500];
    const PAGE_WINDOW = 4;

    const carSelect = document.getElementById('car_id');
    const tableBody = document.getElementById('maintenanceBody');
    const paginationContainer = document.getElementById('paginationContainer');
    const grandTotalLabel = document.getElementById('grandTotal');
    const searchForm = document.getElementById('frmGetMaintenance');

    let currentPage = 1;
    let rowCount = 10;

    // Escape values before injecting them into HTML attributes.
    const escape = (value) =>
        String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

    const getCarId = () => carSelect.value || '';

    const fetchJson = async (url) => {
        const response = await fetch(url);
        return response.json();
    };

    async function loadCars() {
        const cars = await fetchJson('/api/v1/car');
        for (const car of cars) {
            const label = `${car.brand || ''} ${car.model || ''} - ${car.registration_number || ''}`.trim();
            const option = new Option(label, car.id);
            carSelect.add(option);
        }
    }

    async function loadMaintenances(page = 1, perPage = rowCount) {
        currentPage = page;
        rowCount = perPage;

        const query = new URLSearchParams({
            car_id: getCarId(),
            page: currentPage,
            rowCount: rowCount,
        });

        const res = await fetchJson(`/api/v1/maintenance/?${query}`);
        // API returns { data, meta: { current_page, last_page, per_page, total } } —
        // adapt it once here to the shape the render functions expect.
        renderTable(res.data);
        renderPagination(res.meta);
        // renderGrandTotal(data.total_amount);
    }

    function renderTable(items) {
        if (!items || !items.length) {
            tableBody.innerHTML = '<tr><td colspan="6">No record found.</td></tr>';
            return;
        }

        tableBody.innerHTML = items.map((item) => {
            const categoryTitle = item.category?.title ?? '';
            return `
                <tr>
                    <td><span class="pj-form-field-custom pj-form-field-custom-before">
                        <input type="text" class="pj-form-field w140" value="${escape(categoryTitle)}" readonly/>
                    </span></td>
                    <td><span class="pj-form-field-custom pj-form-field-custom-before">
                        <input type="text" name="description" class="pj-form-field pj-description" style="width: 90%;" data-index="${escape(item.id)}" value="${escape(item.description || '')}"/>
                    </span></td>
                    <td><span class="pj-form-field-custom pj-form-field-custom-before">
                        <input type="text" name="odometer" class="pj-form-field w90 pj-km" data-index="${escape(item.id)}" value="${escape(item.odometer || 0)}"/>
                    </span></td>
                    <td><span class="pj-form-field-custom pj-form-field-custom-before">
                        <span class="pj-form-field-before"><abbr class="pj-form-field-icon-text">$</abbr></span>
                        <input type="text" name="amount" class="pj-form-field align_right w50 number pj-maintenance-amount" data-index="${escape(item.id)}" value="${escape(item.amount || '0.00')}"/>
                    </span></td>
                    <td><span class="pj-form-field-custom pj-form-field-custom-after">
                        <input type="text" name="date" value="${escape(item.date || '')}" data-index="${escape(item.id)}" class="pj-form-field pointer w110 datetimepick pj-date"/>
                    </span></td>
                    <td><a class="pj-table-icon-delete btnDeleteMaintenance" title="Delete" href="#" data-id="${escape(item.id)}"></a></td>
                </tr>`;
        }).join('');

        // datetimepicker is a jQuery-UI plugin (timepicker-addon) — no vanilla equivalent, keep it on jQuery.
        if (window.jQuery) {
            window.jQuery('.datetimepick').datetimepicker({
                dateFormat: 'mm/dd/yy',
                timeFormat: 'HH:mm',
            });
        }
    }

    function renderPagination(pagination) {
        if (!pagination || pagination.total === 0) {
            paginationContainer.innerHTML = '';
            return;
        }

        const start = Math.max(1, pagination.page - PAGE_WINDOW);
        const end = Math.min(pagination.total_pages, pagination.page + PAGE_WINDOW);

        const links = [];

        if (pagination.page > 1) {
            links.push(`<a href="#" class="pj-paginator-list-prev" data-page="${pagination.page - 1}">« Prev</a>`);
        }
        if (start > 1) {
            links.push('<a href="#" class="pj-paginator-list-paginate" data-page="1">1</a>');
        }
        for (let page = start; page <= end; page++) {
            const active = page === pagination.page ? ' pj-paginator-list-active' : '';
            links.push(`<a href="#" class="pj-paginator-list-paginate${active}" data-page="${page}">${page}</a>`);
        }
        if (end < pagination.total_pages) {
            links.push(`<a href="#" class="pj-paginator-list-paginate" data-page="${pagination.total_pages}">${pagination.total_pages}</a>`);
        }
        if (pagination.page < pagination.total_pages) {
            links.push(`<a href="#" class="pj-paginator-list-next" data-page="${pagination.page + 1}">Next »</a>`);
        }

        const rowCountMenu = ROWS_PER_PAGE_OPTIONS
            .map((count) => `<li><a href="#" class="pj-selector-row-count" data-rowcount="${count}">${count}</a></li>`)
            .join('');

        paginationContainer.innerHTML = `
            <div class="pj-paginator" style="width: 100%;">
                <span class="pj-paginator-goto">Go to page:
                    <input type="text" name="goto" value="${pagination.page}" style="width: 20px;" class="pj-form-field pj-form-text pj-selector-goto">
                </span>
                <ul class="pj-paginator-list">${links.join('')}</ul>
                <span class="pj-paginator-total">Total items: ${pagination.total} /
                    <a href="#" class="pj-button pj-paginator-row-count">${pagination.per_page}</a>
                    <span style="display: none;" class="pj-menu-list-wrap">
                        <span class="pj-menu-list-arrow"></span>
                        <ul class="pj-menu-list">
                            <li><span style="font-size: 11px;">Items per page</span></li>
                            ${rowCountMenu}
                        </ul>
                    </span>
                </span>
                <span style="clear: both;"></span>
            </div>`;
    }

    function renderGrandTotal(amount) {
        const total = Number.parseFloat(amount || 0).toFixed(2);
        grandTotalLabel.textContent = `Grant total: $${total}`;
    }

    searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        loadMaintenances(1, rowCount);
    });

    // All pagination controls live inside paginationContainer — delegate from there.
    paginationContainer.addEventListener('click', (event) => {
        const pageLink = event.target.closest('.pj-paginator-list-paginate, .pj-paginator-list-prev, .pj-paginator-list-next');
        if (pageLink) {
            event.preventDefault();
            loadMaintenances(Number.parseInt(pageLink.dataset.page, 10), rowCount);
            return;
        }

        const rowCountToggle = event.target.closest('.pj-paginator-row-count');
        if (rowCountToggle) {
            event.preventDefault();
            const menu = rowCountToggle.parentElement.querySelector('.pj-menu-list-wrap');
            menu.style.display = menu.style.display === 'none' ? '' : 'none';
            return;
        }

        const rowCountOption = event.target.closest('.pj-selector-row-count');
        if (rowCountOption) {
            event.preventDefault();
            loadMaintenances(1, Number.parseInt(rowCountOption.dataset.rowcount, 10));
        }
    });

    paginationContainer.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && event.target.matches('.pj-selector-goto')) {
            event.preventDefault();
            const page = Number.parseInt(event.target.value, 10) || 1;
            loadMaintenances(page, rowCount);
        }
    });

    loadCars();
    loadMaintenances(1, rowCount);
});
</script>
{% endblock %}
