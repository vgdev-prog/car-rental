{% extends '@Common/templates/mail-layout.html.twig' %}

{% block title %}Welcome to CitiCarRentals{% endblock %}

{% block preheader %}Confirm your email to activate your CitiCarRentals account.{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:24px; line-height:1.3; color:#1f2933;">
        Welcome aboard!
    </h1>

    <p style="margin:0 0 16px; font-size:16px; line-height:1.6; color:#3e4c59;">
        Thanks for signing up with CitiCarRentals. One last step &mdash;
        confirm your email address to activate your account and start booking cars.
    </p>

    {# CTA button #}
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:28px 0;">
        <tr>
            <td align="center" style="border-radius:6px; background-color:#0b3d2e;">
                <a href="{{ confirmationUrl }}"
                   style="display:inline-block; padding:14px 32px; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:6px;">
                    Confirm my email
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 8px; font-size:14px; line-height:1.6; color:#7b8794;">
        If the button doesn&rsquo;t work, copy and paste this link into your browser:
    </p>
    <p style="margin:0 0 24px; font-size:14px; line-height:1.6; word-break:break-all;">
        <a href="{{ confirmationUrl }}" style="color:#0b3d2e;">{{ confirmationUrl }}</a>
    </p>

    <p style="margin:0; font-size:13px; line-height:1.6; color:#9aa5b1;">
        If you didn&rsquo;t create a CitiCarRentals account, you can safely ignore this email.
    </p>
{% endblock %}
